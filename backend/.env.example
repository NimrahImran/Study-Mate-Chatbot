# Copy this file to ".env" in the same folder (backend/.env) and fill in
# your real Groq API key. Never commit your actual .env file to git.

# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=GROQ

# Optional overrides (safe to leave as-is)
GROQ_MODEL=openai/gpt-oss-120b
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=True
