# Copy this file to ".streamlit/secrets.toml" (same folder) for LOCAL
# testing of the Streamlit app, and fill in your real key.
#
# On Streamlit Community Cloud, you do NOT upload this file — instead,
# paste the same two lines into your app's Settings → Secrets box in the
# dashboard.

GROQ_API_KEY = "your_real_groq_api_key_here"
GROQ_MODEL = "openai/gpt-oss-120b"
